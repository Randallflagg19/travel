# Allow the deploy user to operate only the isolated Travel staging backend.
# Validate with `visudo -cf` before installing into /etc/sudoers.d/.
Cmnd_Alias TRAVEL_STAGING_BACKEND = \
  /usr/bin/systemctl start travel-backend-staging.service, \
  /usr/bin/systemctl restart travel-backend-staging.service, \
  /usr/bin/systemctl is-active travel-backend-staging.service

tapiradmin ALL=(root) NOPASSWD: TRAVEL_STAGING_BACKEND
