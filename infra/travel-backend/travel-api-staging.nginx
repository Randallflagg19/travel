# Install this HTTP vhost only after the DNS A record for api-staging.tapir.su
# points to the VPS. Run Certbot afterwards; it will append the HTTPS blocks.
server {
    listen 80;
    listen [::]:80;
    server_name api-staging.tapir.su;

    access_log /var/log/nginx/travel-api-staging.access.log;
    error_log /var/log/nginx/travel-api-staging.error.log;

    location / {
        proxy_pass http://127.0.0.1:3011;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
